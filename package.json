{
	"absolutejs": {
		"manifestContract": 1
	},
	"author": "Alex Kahn",
	"bugs": {
		"url": "https://github.com/absolutejs/scoped-state/issues"
	},
	"dependencies": {
		"@absolutejs/manifest": "^0.1.0",
		"@sinclair/typebox": "^0.34.0"
	},
	"description": "A state management library for Elysia, scoped to individual users.",
	"devDependencies": {
		"@absolutejs/absolute": "^0.19.0-beta.1051",
		"@elysiajs/static": "1.2.0",
		"@stylistic/eslint-plugin-ts": "4.2.0",
		"@types/bun": "latest",
		"elysia": "1.3.5",
		"eslint": "9.26.0",
		"eslint-plugin-absolute": "0.0.3",
		"eslint-plugin-import": "2.31.0",
		"eslint-plugin-promise": "7.2.1",
		"eslint-plugin-security": "3.0.1",
		"prettier": "3.5.3",
		"typescript": "5.8.3",
		"typescript-eslint": "8.32.0"
	},
	"exports": {
		".": {
			"default": "./dist/index.js",
			"import": "./dist/index.js",
			"types": "./dist/src/index.d.ts"
		},
		"./manifest": {
			"default": "./dist/manifest.js",
			"import": "./dist/manifest.js",
			"types": "./dist/src/manifest.d.ts"
		},
		"./manifest.json": "./dist/manifest.json"
	},
	"files": [
		"dist",
		"README.md"
	],
	"homepage": "https://github.com/absolutejs/scoped-state",
	"license": "MIT",
	"main": "./dist/index.js",
	"name": "@absolutejs/scoped-state",
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/absolutejs/scoped-state.git"
	},
	"scripts": {
		"build": "rm -rf dist && bun build src/index.ts src/manifest.ts --outdir dist --root ./src --target=bun --external elysia && tsc --emitDeclarationOnly --project tsconfig.json && absolute-manifest emit",
		"config": "absolute config",
		"dev": "bun run --watch example/server.ts",
		"format": "prettier --write \"./**/*.{js,jsx,ts,tsx,css,json,mjs,md,html}\"",
		"lint": "eslint ./",
		"release": "bun run format && bun run build && bun publish",
		"test": "echo \"Error: no test specified\" && exit 1",
		"typecheck": "bun run tsc --noEmit"
	},
	"types": "./dist/src/index.d.ts",
	"version": "0.1.3"
}
