{
	"absolutejs": {
		"manifestContract": 2
	},
	"author": "Alex Kahn",
	"bugs": {
		"url": "https://github.com/absolutejs/scoped-state/issues"
	},
	"dependencies": {
		"@absolutejs/manifest": "^0.9.0",
		"@sinclair/typebox": "^0.34.0"
	},
	"description": "A state management library for Elysia, scoped to individual users.",
	"devDependencies": {
		"@absolutejs/absolute": "^0.20.0-beta.0",
		"@absolutejs/changelog": "^0.5.1",
		"@elysia/static": "2.0.0-beta.2",
		"@stylistic/eslint-plugin-ts": "4.2.0",
		"@types/bun": "latest",
		"elysia": "2.0.0-beta.6",
		"eslint": "9.26.0",
		"eslint-plugin-absolute": "0.0.3",
		"eslint-plugin-import": "2.31.0",
		"eslint-plugin-promise": "7.2.1",
		"eslint-plugin-security": "3.0.1",
		"exact-mirror": "1.2.4",
		"prettier": "3.5.3",
		"typebox": "1.3.16",
		"typescript": "5.9.3",
		"typescript-eslint": "8.32.0"
	},
	"exports": {
		".": {
			"default": "./dist/index.js",
			"import": "./dist/index.js",
			"types": "./dist/src/index.d.ts"
		},
		"./manifest": {
			"default": "./dist/manifest.js",
			"import": "./dist/manifest.js",
			"types": "./dist/src/manifest.d.ts"
		},
		"./manifest.json": "./dist/manifest.json"
	},
	"files": [
		"CHANGELOG.md",
		"README.md",
		"changelog.json",
		"dist"
	],
	"homepage": "https://github.com/absolutejs/scoped-state",
	"license": "MIT",
	"main": "./dist/index.js",
	"name": "@absolutejs/scoped-state",
	"peerDependencies": {
		"elysia": "^2.0.0-beta.6"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/absolutejs/scoped-state.git"
	},
	"scripts": {
		"build": "rm -rf dist && bun build src/index.ts src/manifest.ts --outdir dist --root ./src --target=bun --external elysia && tsc --emitDeclarationOnly --project tsconfig.build.json && absolute-manifest emit",
		"config": "absolute config",
		"dev": "bun run --watch example/server.ts",
		"format": "prettier --write \"./**/*.{js,jsx,ts,tsx,css,json,mjs,md,html}\"",
		"lint": "eslint ./",
		"release": "bun run format && bun run build && bun publish",
		"test": "bun test",
		"typecheck": "bun run tsc --noEmit",
		"check:package": "absolute-changelog check",
		"prepublishOnly": "absolute-changelog check"
	},
	"types": "./dist/src/index.d.ts",
	"version": "0.2.2"
}
